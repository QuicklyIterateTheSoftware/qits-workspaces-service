<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-workspaces</artifactId>
        <version>2026.905.164818</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The workspace-daemon control-plane wire contract: plain records + enums + the shared
         type/field-name constants, framework-free and dependency-free. No JSON library on purpose —
         each side serializes with whatever it already carries (Jackson here, Vert.x JsonObject in
         the native daemon binary).

         VENDORED COPY. The canonical source is
         qits-workspace-daemon/workspace-daemon-protocol (this repo's sibling submodule). It is
         copied rather than depended on because that module is published to no registry, and a clone
         of qits-workspaces alone must `mvn verify` green — no GitHub Packages credentials, no
         prior `mvn install` in another repo, no recursive submodule checkout dragging a GraalVM
         native build into this reactor.

         Two things keep the copy honest:
           - The java PACKAGE is identical (eu.wohlben.qits.workspacedaemon.protocol), so the day
             this artifact is published somewhere, deleting this module and adding a <dependency>
             is a one-line change with no source edits.
           - The artifactId is NOT identical — qits-workspaces-daemon-protocol under a different
             groupId — so the two jars can never collide in ~/.m2 or on one classpath.
           - DaemonCodecTest travels with it. It is the contract test, and it now runs on both
             sides; a drift in either repo fails a build rather than a socket at runtime. Any change
             here must be mirrored in the daemon repo and bump DaemonProtocol.CAPABILITY_VERSION. -->
    <artifactId>qits-workspaces-daemon-protocol</artifactId>
    <name>qits-workspaces :: daemon-protocol (vendored)</name>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
