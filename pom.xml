<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone parent for the extracted qits-workspaces repo (docs/epics/qits-workspaces in the
         qits-backend monorepo). The HOST side of workspaces: the workspace entity and its lifecycle,
         container orchestration (docker run/stop/rm/volumes), host-side git against the bare origin,
         the framework-free workspace-daemon SPIs, the workspace registry, and the routes over them.
         Everything that RUNS inside the container — file access, framework detection, and the
         execution of the bootstrap chain and the dev servers — belongs to qits-workspace-daemon and
         is deliberately absent. The host's side of those (the awaiter, the run records, the event
         feed, the proxy, the surfaces) is here; see README.md.

         DELIBERATELY ITS OWN GAV, unlike the qits-workspace-daemon extraction which kept
         eu.wohlben:qits so its children's <parent> resolved unchanged. That works when the child
         artifactIds are globally unique (`workspace-daemon`); it does NOT work here, where the
         modules are `domain` and `service`. Installing eu.wohlben:domain:1.0.0-SNAPSHOT would
         clobber the monorepo's jar in the shared ~/.m2 — and in the qits_shared_m2 volume every
         workspace container mounts. The directories stay domain/ and service/; only the coordinates
         are namespaced.

         Versions that must stay in step with qits (Quarkus platform, JDK release, MapStruct, Lombok)
         are duplicated here on purpose: a clone of THIS repo alone must build, with no monorepo and
         no parent to inherit from.

         Trimmed to what these modules actually need. The monorepo's app-wide machinery is
         intentionally omitted: spotless, the :8080 dev-mode port guard, isolated-test surefire
         chunking, enforcer, the derive-fixture-bares antrun step, the maven build-cache extension,
         and the mandatory -Dqits.variant=oauth|forwardauth|local auth profiles. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-workspaces</artifactId>
    <version>2026.905.164818</version>
    <packaging>pom</packaging>
    <name>qits-workspaces</name>

    <modules>
        <!-- Listed in dependency order for readability; Maven computes reactor order itself. -->
        <module>workspace-daemon-protocol</module>
        <module>gitmirror</module>
        <module>domain</module>
        <module>service</module>
    </modules>

    <properties>
        <qits.eventstream.version>2026.904.82646</qits.eventstream.version>
        <!-- Both come out of qits-integrations-quarkus, so they move together. -->
        <qits.db-core.version>2026.904.82648</qits.db-core.version>
        <qits.arch-rules.version>2026.904.82648</qits.arch-rules.version>
        <qits.auth-core.version>2026.904.82648</qits.auth-core.version>
        <qits.containers-client.version>2026.904.210416</qits.containers-client.version>
        <!-- The user-story framework (test scope everywhere): the whole story catalogue under
             service/src/test/.../stories/ (plus TokenValidationBootstrapIT, which owns the boot)
             is written as @UserStory methods, so `mvn verify -DskipITs=false` regenerates
             service/target/userstories/ — the proof as documentation, with a network diagram
             beside the steps, OBSERVED rather than narrated. This version is the one that ships
             NetworkTaps.restAssured, which replaced the hand-copied StoryNetworkFilter this repo
             used to keep beside its IT. Nothing in src/main knows any of it exists. -->
        <qits.userflows.version>2026.904.223009</qits.userflows.version>
        <!-- The recording service mocks that IT boots against (the generic MockService plus
             idp.MockIdp), released out of libs/qits-integrations-quarkus like qits-db-core and
             qits-auth-core above — the same-string policy applies the day this repo consumes a
             newer reactor of it. -->
        <qits.service-mock.version>2026.904.82648</qits.service-mock.version>
        <qits.maven.repository.url>http://registry.dev.localhost:8080/artifacts/maven/maven</qits.maven.repository.url>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <!-- The suites need a real PostgreSQL, because the store IS PostgreSQL now — and the first
             rule here is that a clone tests green with NO DOCKER, which rules out Testcontainers
             and Quarkus dev services alike. Zonky resolves real postgres binaries as ordinary Maven
             artifacts and spawns them as a child process: a maven dependency, not a container.

             Two coordinates, on purpose. The BOM pins which POSTGRES the binaries are (18.4.0 — the
             platform's own postgres tag, so the lineage is proved against the engine it ships on),
             the library version is the harness around them, and they move independently. Every
             architecture a suite may run on is named explicitly in the modules that use it: the
             binaries are per-arch artifacts, and a missing one fails in the middle of a suite rather
             than during resolution. -->
        <zonky.embedded-postgres.version>2.2.2</zonky.embedded-postgres.version>
        <zonky.postgres-binaries.version>18.4.0</zonky.postgres-binaries.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <failsafe-plugin.version>3.5.4</failsafe-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>
        <lombok.version>1.18.38</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- Quinoa is a quarkiverse extension and is NOT in quarkus-bom, so unlike every io.quarkus
             dependency in `service` it carries a version of its own. 2.8.2 is the last release built
             against a Quarkus OLDER than this platform's 3.34.6 (3.27.3 LTS); 2.8.3 moved to 3.36.2,
             which is AHEAD of the platform. Older is the compatible direction, so 2.8.2 it is — the
             same version every other Quinoa-serving service here pins (qits-ci's root pom records
             the identical reasoning), and the point is that they move together rather than each
             proving a version for itself. -->
        <quinoa.version>2.8.2</quinoa.version>

        <!-- The container ITs need docker, a pulled qits/workspace image (the published, layered
             one — see AGENTS.md) and the daemon native binary, none of which a fresh clone has.
             `mvn verify` must be green without them.

             AND IT STAYS true NOW THAT A PACKAGED IT EXISTS. TokenValidationBootstrapIT needs no
             docker at all — it boots the fast-jar against an embedded postgres and a MockIdp — but
             failsafe has one run per module, so flipping this on would turn the five docker-backed
             Daemon*IT back on with it. They self-skip, yet a `mvn verify` that shells `docker image
             inspect` five times is exactly what the clone-alone rule forbids, and the qits-githost
             precedent (skipITs=false in its service module) only works there because that repo has
             no such siblings. So the userflow run opts itself in by NAME instead:
             .config/qits/ci-event-userflows.yml passes
             `-DskipITs=false -Dit.test=TokenValidationBootstrapIT`, which is also the incantation
             to run it by hand. -->
        <skipITs>true</skipITs>
        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- Which postgres the embedded binaries ARE — 18.4.0, the tag the platform's own
                     qits-oci-postgresql image is built from. Imported as a BOM because the per-arch
                     artifacts the modules name are separate coordinates. -->
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${zonky.postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${zonky.embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- The reactor's own modules, so children depend on them version-less. -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-workspaces-daemon-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <!-- The git substrate: the mirror cache, its worktrees and its pushes. Framework
                     -free like the daemon protocol beside it, so `domain` gets a library and not a
                     second CDI graph. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-workspaces-gitmirror</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-eventstream</artifactId>
                <version>${qits.eventstream.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-auth-core</artifactId>
                <version>${qits.auth-core.version}</version>
            </dependency>
            <dependency>
                <!-- The platform's database resilience: PatientPgDriver, which every postgresql
                     datasource here opens its connections through, and DbRetry, which holds a read
                     seam through a cutover that severed the connection mid-flight. Compile scope,
                     because both are on the running app's classpath — the driver is named by config
                     and the retry is called from code. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-db-core</artifactId>
                <version>${qits.db-core.version}</version>
            </dependency>
            <dependency>
                <!-- The platform's shared ArchUnit rules, test scope wherever entities live. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-arch-rules</artifactId>
                <version>${qits.arch-rules.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at every declaration site, like qits-arch-rules: the stories run in
                     the build and ship in nothing. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-userflows</artifactId>
                <version>${qits.userflows.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at every declaration site, like qits-arch-rules. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-service-mock</artifactId>
                <version>${qits.service-mock.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-workspaces-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <!-- The orchestrator's client jar: the only way this service reaches a container.
                     Pinned at a RELEASED calver and never a snapshot — a snapshot resolves from a
                     developer's own ~/.m2 and fails in the step container that builds the release. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-containers-client</artifactId>
                <version>${qits.containers-client.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>qits-maven</id>
            <url>${qits.maven.repository.url}</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <!-- Incremental compilation leaves stale MapStruct *Impl classes behind
                             when a mapper's shape changes; the monorepo disables it for the same
                             reason. -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <!-- No java.util.logging.manager here on purpose: the daemon-protocol module is
                         dependency-free and has no jboss-logmanager on its test classpath. The two
                         Quarkus modules set it themselves. -->
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
