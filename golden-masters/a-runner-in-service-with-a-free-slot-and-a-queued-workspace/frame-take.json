{
  "type": "take",
  "rowId": 1,
  "spec": {
    "image": "registry.qits.runners.example.test/qits/workspace:2026.101.120000",
    "env": {
      "TZ": "GMT",
      "QITS_WORKSPACE_DAEMON_URL": "wss://workspaces.qits.runners.example.test/workspaces/daemon/1",
      "QITS_PLATFORM_MCP_URL": "https://mcp.qits.runners.example.test/mcp",
      "QITS_WORKSPACE_DAEMON_GIT_BASE_URL": "https://githost.qits.runners.example.test/git",
      "QITS_WORKSPACE_DAEMON_API_BASE_PATH": "/workspaces/container/1/",
      "QITS_WORKSPACE_DAEMON_WORKSPACE_ID": "ws-contract",
      "QITS_WORKSPACE_DAEMON_REPOSITORY_ID": "00000000-0000-4000-8000-000000000013",
      "QITS_WORKSPACE_DAEMON_PROJECT_ID": "test-project",
      "QITS_WORKSPACE_DAEMON_REPO_NAME": "name-of-00000000-0000-4000-8000-000000000013",
      "QITS_WORKSPACE_DAEMON_AUTO_PUSH_ENABLED": "true",
      "QITS_WORKSPACE_DAEMON_API_TOKEN": "qits-workspace-daemon",
      "QITS_TOKEN": "qits_tok_contract-workspace",
      "QITS_TOKEN_SUBJECT": "contract-workspace-token",
      "GIT_CONFIG_GLOBAL": "/etc/qits-gitconfig",
      "QITS_GIT_AUTH_HOST": "githost.qits.runners.example.test",
      "GIT_AUTHOR_NAME": "qits",
      "GIT_AUTHOR_EMAIL": "qits@local",
      "GIT_COMMITTER_NAME": "qits",
      "GIT_COMMITTER_EMAIL": "qits@local",
      "CLAUDE_CONFIG_DIR": "/claude-home/.claude",
      "KIMI_CODE_HOME": "/claude-home/.kimi-code",
      "MAVEN_OPTS": "-Dmaven.repo.local=/caches/m2",
