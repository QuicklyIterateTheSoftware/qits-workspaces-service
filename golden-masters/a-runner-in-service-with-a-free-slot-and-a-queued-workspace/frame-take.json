      },
      {
        "volume": "M2",
        "target": "/caches/m2"
      },
      {
        "volume": "PNPM",
        "target": "/caches/pnpm"
      }
    ],
    "labels": {
      "qits.repository": "00000000-0000-4000-8000-000000000013",
